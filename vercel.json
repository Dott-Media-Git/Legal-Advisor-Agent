{
  "version": 2,
  "regions": ["dub1"],
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "index.html",
          "dotti.html",
          "signup.html",
          "app/**",
          "lib/**",
          "data/store.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.mjs"
    }
  ]
}
